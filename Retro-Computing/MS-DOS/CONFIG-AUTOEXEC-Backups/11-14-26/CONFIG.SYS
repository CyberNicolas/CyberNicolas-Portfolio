REM CONFIG.SYS
REM 4DOS 750 v1
REM 10-08-2026

[MENU]
MENUITEM=4DOS, 4DOS 750
MENUITEM=MSDOS, MS-DOS 6.22
MENUDEFAULT=4DOS,5

[COMMON]
DEVICE=C:\DOS\SETVER.EXE
DEVICE=C:\DOS\HIMEM.SYS
DOS=HIGH
FILES=30

[4DOS]
SHELL=C:\4DOS\4DOS.COM C:\4DOS\ /P

[MSDOS]
SHELL=C:\COMMAND.COM C:\ /P
