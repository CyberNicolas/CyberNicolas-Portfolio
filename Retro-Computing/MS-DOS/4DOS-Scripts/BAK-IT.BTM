@ECHO OFF
ECHO %_DATE

REM MAKE BACK DIR
MKDIR C:\BAKS\%_DATE

REM COPY CONFIG FILES
COPY C:\CONFIG.SYS C:\BAKS\%_DATE
COPY C:\AUTOEXEC.BAT C:\BAKS\%_DATE

REM COMPRESS BAKS
C:\PKWARE\PKZIP.EXE -a C:\BAKS\%_DATE\BACKUP.ZIP C:\BAKS\%_DATE\CONFIG.SYS C:\BAKS\%_DATE\AUTOEXEC.BAT

REM DEL SYS AND BAT FILES
DEL /Q C:\BAKS\%_DATE\CONFIG.SYS
DEL /Q C:\BAKS\%_DATE\AUTOEXEC.BAT

ECHO Backup Complete!
